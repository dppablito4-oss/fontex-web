# Las variables VITE_* son públicas. Nunca uses service_role ni sb_secret_* en ellas.
VITE_BASE_PATH=/
VITE_SUPABASE_URL=https://goegjuglstapjwcckawp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Solo servidor local de Vite. No usar prefijo VITE_.
OPENAI_API_KEY=

# Solo servidor. studio-agent y classroom-agent: Responses y JSON Schema.
# Vacío o valor antiguo gpt-6.1-sol: gpt-6.1-terra.
FONTEX_AGENT_MODEL=

# Solo servidor. Modelo de conversación; por defecto gpt-6-luna.
FONTEX_CHAT_MODEL=

# Solo servidor. Override explícito del tutor documental tutor-chat.
# Sin override usa el modelo de tutor_limits; los defaults antiguos Astra/Sol pasan a Terra.
OPENAI_MODEL=

# Solo servidor. Avisos de clases; no es la contraseña SMTP de Auth.
# FONTEX_SMTP_PASSWORD= (configurar en Edge Function Secrets, nunca en el cliente)
